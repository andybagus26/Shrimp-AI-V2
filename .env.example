# GEMINI_API_KEY: Required for Gemini AI API calls (fallback jika Flask offline).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL dimana app ini di-host (diisi otomatis oleh Vercel/Railway).
APP_URL="MY_APP_URL"

# FLASK_API_URL: URL Railway Flask backend untuk YOLOv8 AI.
# Contoh: https://shrimp-ai-flask.up.railway.app
FLASK_API_URL="https://your-flask-service.up.railway.app"
